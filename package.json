{
  "name": "forgeplay",
  "private": true,
  "description": "ForgePlay monorepo root. Node tooling here only serves apps/web; Go and Godot builds go through the Makefile.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=12"
  },
  "scripts": {
    "web:dev": "pnpm --filter @forgeplay/web dev",
    "web:build": "pnpm --filter @forgeplay/web build",
    "web:preview": "pnpm --filter @forgeplay/web preview",
    "web:check": "pnpm --filter @forgeplay/web check"
  }
}
