# ForgePlay server environment. Copy to .env and fill in secrets later.
# Keys listed here are read by apps/server/internal/app/config.go. Empty values
# keep the matching capability in stub/dev mode; the client shows that honestly.

# --- runtime ---
FORGEPLAY_ENV=development
PORT=8080
FORGEPLAY_DB=
FORGEPLAY_SECRET=
FORGEPLAY_SHUTDOWN_TIMEOUT=10s
FORGEPLAY_MAX_BODY_BYTES=1048576
FORGEPLAY_TRUSTED_PROXIES=

# --- content paths ---
FORGEPLAY_SCHEMA_DIR=../../packages/schemas
FORGEPLAY_RUNTIME_DIR=../client/runtime
FORGEPLAY_BASELINE=../client/runtime/shooter/baseline.dsl.json
FORGEPLAY_SURVIVOR_BASELINE=../client/runtime/survivor/baseline.dsl.json
FORGEPLAY_TOWER_DEFENSE_BASELINE=../client/runtime/tower_defense/baseline.dsl.json

# --- AI (empty = stub provider) ---
ANTHROPIC_API_KEY=

# --- SMS (empty = log/dev sender) ---
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# --- OAuth verify gateways (empty = provider disabled) ---
OAUTH_WECHAT_VERIFY_URL=
OAUTH_WECHAT_VERIFY_TOKEN=
OAUTH_QQ_VERIFY_URL=
OAUTH_QQ_VERIFY_TOKEN=
OAUTH_APPLE_VERIFY_URL=
OAUTH_APPLE_VERIFY_TOKEN=
OAUTH_GOOGLE_VERIFY_URL=
OAUTH_GOOGLE_VERIFY_TOKEN=
OAUTH_DISCORD_VERIFY_URL=
OAUTH_DISCORD_VERIFY_TOKEN=
OAUTH_LINE_VERIFY_URL=
OAUTH_LINE_VERIFY_TOKEN=

# --- admin / moderation ---
FORGEPLAY_ADMIN_IDS=
FORGEPLAY_DEV_ADMIN=false
FORGEPLAY_BLOCK_WORDS_FILE=
CONTENT_MODERATION_URL=
CONTENT_MODERATION_TOKEN=

# --- payments ---
PAYMENT_WEBHOOK_SECRET=
