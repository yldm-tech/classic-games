# Classic Games server environment. Copy to .env and fill in secrets later.
# Keys listed here are read by apps/server/internal/app/config.go. Empty values
# keep the matching capability in stub/dev mode; the client shows that honestly.

# --- runtime ---
CLASSIC_GAMES_ENV=development
PORT=8080
CLASSIC_GAMES_DB=
CLASSIC_GAMES_SECRET=
CLASSIC_GAMES_SHUTDOWN_TIMEOUT=10s
CLASSIC_GAMES_MAX_BODY_BYTES=1048576
CLASSIC_GAMES_TRUSTED_PROXIES=

# --- content paths ---
CLASSIC_GAMES_SCHEMA_DIR=../../packages/schemas
CLASSIC_GAMES_RUNTIME_DIR=../client/runtime
CLASSIC_GAMES_BASELINE=../client/runtime/shooter/baseline.dsl.json
CLASSIC_GAMES_SURVIVOR_BASELINE=../client/runtime/survivor/baseline.dsl.json
CLASSIC_GAMES_TOWER_DEFENSE_BASELINE=../client/runtime/tower_defense/baseline.dsl.json

# --- AI (empty = stub provider) ---
ANTHROPIC_API_KEY=

# --- SMS (empty = log/dev sender) ---
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# --- OAuth verify gateways (empty = provider disabled) ---
OAUTH_WECHAT_VERIFY_URL=
OAUTH_WECHAT_VERIFY_TOKEN=
OAUTH_QQ_VERIFY_URL=
OAUTH_QQ_VERIFY_TOKEN=
OAUTH_APPLE_VERIFY_URL=
OAUTH_APPLE_VERIFY_TOKEN=
OAUTH_GOOGLE_VERIFY_URL=
OAUTH_GOOGLE_VERIFY_TOKEN=
OAUTH_DISCORD_VERIFY_URL=
OAUTH_DISCORD_VERIFY_TOKEN=
OAUTH_LINE_VERIFY_URL=
OAUTH_LINE_VERIFY_TOKEN=

# --- admin / moderation ---
CLASSIC_GAMES_ADMIN_IDS=
CLASSIC_GAMES_DEV_ADMIN=false
CLASSIC_GAMES_BLOCK_WORDS_FILE=
CONTENT_MODERATION_URL=
CONTENT_MODERATION_TOKEN=

# --- payments ---
PAYMENT_WEBHOOK_SECRET=
