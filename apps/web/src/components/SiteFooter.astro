---
import { REPO_URL, repoFile } from '../config/site.ts';
import { type Locale, landing, localizePath } from '../i18n/landing.ts';
import Wordmark from './Wordmark.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = landing[locale];
const to = (path: string) => localizePath(locale, path);

const columns = [
	{
		heading: t.footer.docsHeading,
		links: [
			{ label: t.footer.docsIndex, href: to('/docs/') },
			{ label: t.footer.clientArchitecture, href: to('/docs/16-client-architecture/') },
			{ label: t.footer.dsl, href: to('/docs/05-dsl-design/') },
			{ label: t.footer.decisions, href: to('/docs/decisions/') },
		],
	},
	{
		heading: t.footer.developersHeading,
		links: [
			{ label: t.footer.gettingStarted, href: to('/developers/getting-started/') },
			{ label: t.footer.cli, href: to('/developers/cli/') },
			{ label: t.footer.mcp, href: to('/developers/mcp/') },
			{ label: t.footer.sdk, href: to('/developers/sdk/') },
		],
	},
	{
		heading: t.footer.projectHeading,
		links: [
			{ label: 'GitHub', href: REPO_URL },
			{ label: t.footer.terms, href: to('/legal/terms/') },
			{ label: t.footer.privacy, href: to('/legal/privacy/') },
			{ label: t.footer.licenses, href: to('/legal/licenses/') },
		],
	},
];
---

<footer class="site-footer">
	<div class="fp-container grid">
		<div class="brand">
			<Wordmark href={to('/')} label={t.nav.home} />
			<p class="tagline">{t.footer.tagline}</p>
		</div>
		{
			columns.map((column) => (
				<nav class="column" aria-label={column.heading}>
					<h2 class="heading">{column.heading}</h2>
					<ul>
						{column.links.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
	</div>
	<div class="fp-container">
		<div class="legal">
			<p><a href={repoFile('LICENSE')}>{t.footer.license}</a></p>
			<p><a href={to('/legal/licenses/')}>{t.footer.artNote}</a></p>
			<p>{t.footer.privacyNote}</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-block-start: 1px solid var(--fp-border-subtle);
		background: var(--fp-bg-sunken);
		padding-block: clamp(2.5rem, 6vw, 4rem) 2rem;
		font-size: 0.9375rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem 1.5rem;
	}

	.brand {
		grid-column: 1 / -1;
	}

	.tagline {
		margin-block-start: 0.9rem;
		max-width: 22rem;
		color: var(--fp-text-muted);
	}

	.heading {
		margin-block-end: 0.6rem;
		font-family: var(--fp-font-mono);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--fp-text-muted);
	}

	.column a {
		display: inline-block;
		padding-block: 0.3rem;
		color: var(--fp-text-secondary);
		text-decoration: none;
	}

	.column a:hover {
		color: var(--fp-text);
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	.legal {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 2rem;
		margin-block-start: 2.5rem;
		padding-block-start: 1.5rem;
		border-block-start: 1px solid var(--fp-border-subtle);
		color: var(--fp-text-muted);
		font-size: 0.875rem;
	}

	.legal a {
		text-underline-offset: 0.25em;
	}

	.legal a:hover {
		color: var(--fp-text);
	}

	@media (min-width: 48rem) {
		.grid {
			grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
		}

		.brand {
			grid-column: auto;
		}
	}
</style>
