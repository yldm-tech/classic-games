---
import type { Locale } from '../i18n/landing.ts';
import LandingLayout from '../layouts/LandingLayout.astro';
import Controls from './landing/Controls.astro';
import Developers from './landing/Developers.astro';
import Games from './landing/Games.astro';
import GetStarted from './landing/GetStarted.astro';
import Hero from './landing/Hero.astro';
import LauncherScreens from './landing/LauncherScreens.astro';
import LocalAndPlanned from './landing/LocalAndPlanned.astro';
import PcMode from './landing/PcMode.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
---

<LandingLayout locale={locale}>
	<Hero locale={locale} />
	<Games locale={locale} />
	<LauncherScreens locale={locale} />
	<PcMode locale={locale} />
	<Controls locale={locale} />
	<LocalAndPlanned locale={locale} />
	<Developers locale={locale} />
	<GetStarted locale={locale} />
</LandingLayout>
