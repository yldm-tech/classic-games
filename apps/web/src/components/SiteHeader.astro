---
import { REPO_URL } from '../config/site.ts';
import { type Locale, landing, localizePath } from '../i18n/landing.ts';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = landing[locale].nav;
const otherLocale: Locale = locale === 'en' ? 'zh-CN' : 'en';
---

<header class="site-header">
	<div class="cg-container bar">
		<Wordmark href={localizePath(locale, '/')} label={t.home} />
		<nav class="links" aria-label={t.primaryLabel}>
			<a class="text-link" href={localizePath(locale, '/docs/')}>{t.docs}</a>
			<a class="text-link wide-only" href={localizePath(locale, '/developers/getting-started/')}>{t.developers}</a>
			<a class="icon-link" href={REPO_URL} aria-label={t.github} title={t.github}><Icon name="github" /></a>
			<a class="lang-link" href={localizePath(otherLocale, '/')} lang={otherLocale} hreflang={otherLocale} aria-label={t.switchLanguage} title={t.otherLanguageName}>{t.otherLanguageShort}</a>
			<button class="icon-link theme-toggle" type="button" data-theme-toggle aria-label={t.themeToggle} title={t.themeToggle}>
				<Icon name="moon" class="when-dark" />
				<Icon name="sun" class="when-light" />
			</button>
		</nav>
	</div>
</header>

<script>
	// Shares Starlight's storage key so the choice made here carries over to the docs and back.
	const STORAGE_KEY = 'starlight-theme';
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
		button.addEventListener('click', () => {
			const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
			document.documentElement.dataset.theme = next;
			if (typeof localStorage !== 'undefined') localStorage.setItem(STORAGE_KEY, next);
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		inset-block-start: 0;
		z-index: 20;
		border-block-end: 1px solid var(--cg-border-subtle);
		background: var(--cg-header-bg);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 4rem;
	}

	.links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.text-link,
	.lang-link,
	.icon-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2.75rem;
		min-height: 2.75rem;
		padding-inline: 0.7rem;
		border: 0;
		border-radius: var(--cg-radius);
		background: transparent;
		color: var(--cg-text-secondary);
		font: inherit;
		font-size: 0.9375rem;
		font-weight: 550;
		text-decoration: none;
		cursor: pointer;
		transition:
			color var(--cg-dur-fast) ease,
			background-color var(--cg-dur-fast) ease;
	}

	.text-link:hover,
	.lang-link:hover,
	.icon-link:hover {
		background: var(--cg-focus-fill);
		color: var(--cg-text);
	}

	.icon-link {
		padding-inline: 0;
	}

	.lang-link {
		font-family: var(--cg-font-mono);
		font-size: 0.8125rem;
		letter-spacing: 0.04em;
	}

	.wide-only {
		display: none;
	}

	.theme-toggle .when-light,
	:global([data-theme='light']) .theme-toggle .when-dark {
		display: none;
	}

	:global([data-theme='light']) .theme-toggle .when-light {
		display: block;
	}

	/* At the narrowest supported widths the row only fits with tighter padding; targets stay at least 40px wide. */
	@media (max-width: 24rem) {
		.bar {
			gap: 0.5rem;
		}

		.links {
			gap: 0;
		}

		.text-link,
		.lang-link {
			min-width: 2.5rem;
			padding-inline: 0.45rem;
		}

		.icon-link {
			min-width: 2.5rem;
		}
	}

	@media (min-width: 40rem) {
		.wide-only {
			display: inline-flex;
		}

		.links {
			gap: 0.5rem;
		}
	}
</style>
