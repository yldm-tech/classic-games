---
// The launcher's own brand line: the Chinese name in heavy, widely spaced type, followed by the Latin name in small letter-spaced capitals (launcher_root.gd draws "launcher.brand" and "launcher.brand_latin" the same way in both languages). Used by the landing header and footer and as Starlight's site title, so every page carries the same brand element.
interface Props {
	href: string;
	label: string;
}

const { href, label } = Astro.props;
---

<a class="fp-wordmark" href={href} aria-label={label}>
	<span class="fp-wordmark-name" lang="zh-CN" translate="no">经典厅</span>
	<span class="fp-wordmark-latin" lang="en" translate="no">Classic Games</span>
</a>

<style>
	.fp-wordmark {
		display: inline-flex;
		align-items: baseline;
		gap: 0.85rem;
		color: var(--fp-text);
		font-family: var(--fp-font-sans);
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
	}

	.fp-wordmark-name {
		font-size: 1.25rem;
		font-weight: 900;
		letter-spacing: 0.3em;
		/* Letter spacing also follows the last character; pull the gap back so the Latin name sits at the intended distance. */
		margin-inline-end: -0.3em;
	}

	.fp-wordmark-latin {
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.36em;
		text-transform: uppercase;
		color: var(--fp-text-muted);
	}

	@media (max-width: 26rem) {
		.fp-wordmark-latin {
			display: none;
		}
	}
</style>
