---
import Phrases from '../Phrases.astro';
import { type Locale, landing } from '../../i18n/landing.ts';
import ForkTree from './ForkTree.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = landing[locale].flow;
---

<section class="fp-section" id="flow" aria-labelledby="flow-title">
	<div class="fp-container">
		<div class="fp-section-head">
			<p class="fp-eyebrow">{t.eyebrow}</p>
			<h2 class="fp-h2" id="flow-title"><Phrases text={t.title} /></h2>
			<p class="fp-lead">{t.lead}</p>
		</div>
		<div class="layout">
			<ol class="steps">
				{
					t.steps.map((step, index) => (
						<li class="step">
							<span class="number" aria-hidden="true">
								{String(index + 1).padStart(2, '0')}
							</span>
							<h3 class="fp-h3">{step.title}</h3>
							<p class="body">{step.body}</p>
						</li>
					))
				}
			</ol>
			<ForkTree locale={locale} />
		</div>
	</div>
</section>

<style>
	.layout {
		display: grid;
		gap: clamp(2rem, 4vw, 3rem);
		align-items: start;
	}

	.steps {
		display: grid;
		gap: 1.75rem 2rem;
	}

	.step {
		padding-block-start: 1rem;
		border-block-start: 2px solid var(--fp-border);
	}

	.step:nth-child(3) {
		border-block-start-color: var(--fp-ai-text);
	}

	.number {
		display: block;
		margin-block-end: 0.5rem;
		font-family: var(--fp-font-mono);
		font-size: 0.8125rem;
		color: var(--fp-text-muted);
	}

	.step:nth-child(3) .number {
		color: var(--fp-ai-text);
	}

	.body {
		margin-block-start: 0.5rem;
		color: var(--fp-text-secondary);
		font-size: 0.9375rem;
	}

	@media (min-width: 36rem) {
		.steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 62rem) {
		.layout {
			grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		}
	}
</style>
