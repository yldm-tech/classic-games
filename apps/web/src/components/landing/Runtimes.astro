---
import Phrases from '../Phrases.astro';
import { repoFile } from '../../config/site.ts';
import { runtimes } from '../../data/runtimes.ts';
import { type Locale, landing, localizePath } from '../../i18n/landing.ts';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = landing[locale].runtimes;
---

<section class="fp-section" id="runtimes" aria-labelledby="runtimes-title">
	<div class="fp-container">
		<div class="fp-section-head">
			<p class="fp-eyebrow">{t.eyebrow}</p>
			<h2 class="fp-h2" id="runtimes-title"><Phrases text={t.title} /></h2>
			<p class="fp-lead">{t.lead}</p>
		</div>

		<ul class="grid">
			{
				runtimes.map((runtime) => (
					<li class="runtime">
						<p class="id">{runtime.id}</p>
						<h3 class="fp-h3">{t.names[runtime.key]}</h3>
						<p class="description">{t.descriptions[runtime.key]}</p>
						<p class="sections-label">{t.sectionsLabel}</p>
						<ul class="sections">
							{runtime.sections.map((section) => (
								<li class="fp-chip">{section}</li>
							))}
						</ul>
						<p class="links">
							<a class="fp-link" data-external href={repoFile(runtime.schemaPath)}>
								{t.schemaLink}
							</a>
							<a class="fp-link" data-external href={repoFile(runtime.baselinePath)}>
								{t.baselineLink}
							</a>
						</p>
					</li>
				))
			}
		</ul>

		<div class="fp-section-foot">
			<a class="fp-link" href={localizePath(locale, '/docs/11-runtime-content/')}>{t.readMore}</a>
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		gap: 1rem;
	}

	.runtime {
		display: flex;
		flex-direction: column;
		padding: 1.4rem 1.4rem 1.3rem;
		border: 1px solid var(--fp-border);
		border-radius: var(--fp-radius-lg);
		background: var(--fp-surface);
	}

	.id {
		align-self: flex-start;
		margin-block-end: 0.9rem;
		padding: 0.1rem 0.55rem;
		border-radius: var(--fp-radius-xs);
		background: var(--fp-tint-ember);
		color: var(--fp-accent-text);
		font-family: var(--fp-font-mono);
		font-size: 0.8125rem;
	}

	.description {
		margin-block-start: 0.5rem;
		color: var(--fp-text-secondary);
		font-size: 0.9375rem;
	}

	.sections-label {
		margin-block: 1.1rem 0.5rem;
		font-family: var(--fp-font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--fp-text-muted);
	}

	.sections {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-block-end: 1.2rem;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.5rem;
		margin-block-start: auto;
		padding-block-start: 1rem;
		border-block-start: 1px solid var(--fp-border-subtle);
		font-size: 0.9375rem;
	}

	@media (min-width: 52rem) {
		.grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
