---
import Phrases from '../Phrases.astro';
import { REPO_URL } from '../../config/site.ts';
import { CLONE_COMMAND_PLACEHOLDER, type Locale, landing, localizePath } from '../../i18n/landing.ts';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = landing[locale].start;
const lines = t.lines.map((line) => (line.text === CLONE_COMMAND_PLACEHOLDER ? { ...line, text: `git clone ${REPO_URL}.git` } : line));
---

<section class="fp-section" id="get-started" aria-labelledby="get-started-title">
	<div class="fp-container layout">
		<div class="copy">
			<p class="fp-eyebrow">{t.eyebrow}</p>
			<h2 class="fp-h2" id="get-started-title"><Phrases text={t.title} /></h2>
			<p class="fp-lead">{t.lead}</p>
			<div class="links">
				<a class="fp-link" href={localizePath(locale, '/developers/getting-started/')}>{t.guideLink}</a>
				<a class="fp-link" data-external href={REPO_URL}>{t.repoLink}</a>
			</div>
		</div>
		<div class="terminal" role="group" aria-label={t.codeLabel}>
			<p class="terminal-label" aria-hidden="true">{t.codeLabel}</p>
			<pre tabindex="0"><code>{lines.map((line) => <span class:list={['line', line.kind]}>{line.text}{'\n'}</span>)}</code></pre>
		</div>
	</div>
</section>

<style>
	.layout {
		display: grid;
		gap: clamp(2rem, 4vw, 3rem);
		align-items: start;
	}

	.copy,
	.terminal {
		min-width: 0;
	}

	.links {
		display: grid;
		justify-items: start;
		gap: 0.6rem;
		margin-block-start: 1.75rem;
	}

	.terminal {
		border: 1px solid var(--fp-border);
		border-radius: var(--fp-radius-lg);
		background: var(--fp-bg-sunken);
		overflow: hidden;
	}

	.terminal-label {
		padding: 0.6rem 1.25rem;
		border-block-end: 1px solid var(--fp-border-subtle);
		font-family: var(--fp-font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--fp-text-muted);
	}

	pre {
		padding: 1.1rem 1.25rem 1.2rem;
		overflow-x: auto;
		font-size: 0.8125rem;
		line-height: 1.75;
		tab-size: 2;
	}

	pre:focus-visible {
		outline-offset: -2px;
	}

	.line.comment {
		color: var(--fp-text-muted);
	}

	.line.command {
		color: var(--fp-text);
	}

	.line.command::before {
		content: '$ ';
		color: var(--fp-accent-text);
		user-select: none;
	}

	@media (min-width: 62rem) {
		.layout {
			grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		}
	}
</style>
