---
import homeShot from '../../assets/launcher/home-played.png';
import Phrases from '../Phrases.astro';
import { REPO_URL } from '../../config/site.ts';
import { games } from '../../data/games.ts';
import { type Locale, landing } from '../../i18n/landing.ts';
import Shot from './Shot.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = landing[locale].hero;
---

<section class="hero" aria-labelledby="hero-title">
	<div class="cg-container">
		<div class="copy">
			<p class="cg-eyebrow">{t.status}</p>
			<h1 id="hero-title"><Phrases text={t.title} /></h1>
			<p class="lead">{t.lead(games.length)}</p>
			<div class="actions">
				<a class="cg-button cg-button-primary" href="#get-started">{t.primaryCta}</a>
				<a class="cg-button cg-button-secondary" href={REPO_URL}>{t.secondaryCta}</a>
			</div>
			<p class="note">{t.note}</p>
		</div>
		<Shot src={homeShot} alt={t.shotAlt} caption={t.shotCaption} sizes="(min-width: 76rem) 71rem, 92vw" eager />
	</div>
</section>

<style>
	.hero {
		padding-block: clamp(3rem, 7vw, 5.5rem) clamp(3rem, 6vw, 5rem);
	}

	.copy {
		max-width: 62rem;
		margin-block-end: clamp(2.5rem, 5vw, 4rem);
	}

	h1 {
		font-size: clamp(2.125rem, 1.2rem + 4vw, 4rem);
		font-weight: 900;
		line-height: 1.12;
		letter-spacing: 0.01em;
		text-wrap: balance;
	}

	.lead {
		margin-block-start: 1.5rem;
		max-width: 44rem;
		font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
		color: var(--cg-text-secondary);
		text-wrap: pretty;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-block-start: 2rem;
	}

	.note {
		margin-block-start: 1.25rem;
		font-size: 0.875rem;
		color: var(--cg-text-muted);
	}
</style>
