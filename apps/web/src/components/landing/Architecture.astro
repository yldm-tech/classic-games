---
import Phrases from '../Phrases.astro';
import { type Locale, landing, localizePath } from '../../i18n/landing.ts';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = landing[locale].architecture;

// The five export targets configured in apps/client/export_presets.cfg, in display order. The list is maintained by hand and the labels are not the preset names: the Windows preset is called "Windows Desktop" there.
const platforms = ['iOS', 'Android', 'macOS', 'Windows', 'Web'];
---

<section class="fp-section" id="architecture" aria-labelledby="architecture-title">
	<div class="fp-container">
		<div class="fp-section-head">
			<p class="fp-eyebrow">{t.eyebrow}</p>
			<h2 class="fp-h2" id="architecture-title"><Phrases text={t.title} /></h2>
			<p class="fp-lead">{t.lead}</p>
		</div>

		<div class="diagram">
			<article class="node client">
				<p class="fp-path">apps/client</p>
				<h3 class="fp-h3">{t.client.title}</h3>
				<ul class="points">
					{t.client.points.map((point) => <li>{point}</li>)}
				</ul>
				<p class="platforms-label">{t.platformsLabel}</p>
				<ul class="platforms">
					{platforms.map((platform) => <li class="fp-chip">{platform}</li>)}
				</ul>
			</article>

			<p class="wire"><span>{t.link}</span></p>

			<article class="node server">
				<p class="fp-path">apps/server</p>
				<h3 class="fp-h3">{t.server.title}</h3>
				<ul class="points">
					{t.server.points.map((point) => <li>{point}</li>)}
				</ul>
			</article>

			<article class="node contract">
				<p class="fp-path">packages/schemas · packages/dsl</p>
				<h3 class="fp-h3">{t.contract.title}</h3>
				<p class="contract-body">{t.contract.body}</p>
			</article>
		</div>

		<div class="fp-section-foot">
			<a class="fp-link" href={localizePath(locale, '/docs/04-architecture/')}>{t.readMore}</a>
			<span class="roadmap">
				{t.roadmapNote}
				<a class="fp-link" href={localizePath(locale, '/docs/07-roadmap/')}>{t.roadmapLink}</a>
			</span>
		</div>
	</div>
</section>

<style>
	.diagram {
		display: grid;
		gap: 0;
	}

	.node {
		padding: 1.4rem 1.4rem 1.5rem;
		border: 1px solid var(--fp-border);
		border-radius: var(--fp-radius-lg);
		background: var(--fp-surface);
	}

	.node .fp-h3 {
		margin-block-start: 0.35rem;
	}

	.points {
		display: grid;
		gap: 0.5rem;
		margin-block-start: 0.9rem;
		color: var(--fp-text-secondary);
		font-size: 0.9375rem;
	}

	.points li {
		position: relative;
		padding-inline-start: 1.1rem;
	}

	.points li::before {
		content: '';
		position: absolute;
		inset-block-start: 0.7em;
		inset-inline-start: 0;
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 1px;
		background: var(--fp-accent);
		transform: rotate(45deg);
	}

	.platforms-label {
		margin-block: 1.1rem 0.5rem;
		font-family: var(--fp-font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--fp-text-muted);
	}

	.platforms {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	/* The wire between client and server: vertical when stacked, horizontal when side by side. */
	.wire {
		display: grid;
		place-items: center;
		min-height: 3.25rem;
		background: linear-gradient(var(--fp-border-strong), var(--fp-border-strong)) center / 1px 100% no-repeat;
	}

	.wire span {
		padding: 0.15rem 0.6rem;
		border: 1px solid var(--fp-border);
		border-radius: var(--fp-radius-pill);
		background: var(--fp-bg);
		font-family: var(--fp-font-mono);
		font-size: 0.75rem;
		color: var(--fp-text-secondary);
		white-space: nowrap;
	}

	/* The contract sits under both sides and is the only volt-edged element here, because it is what constrains the AI. */
	.contract {
		position: relative;
		margin-block-start: 2.25rem;
		border-color: var(--fp-ai-text);
		background: linear-gradient(var(--fp-tint-volt), var(--fp-tint-volt)), var(--fp-surface);
	}

	.contract::before {
		content: '';
		position: absolute;
		inset-block-end: 100%;
		inset-inline: 50% auto;
		height: 2.25rem;
		border-inline-start: 1px dashed var(--fp-ai-text);
	}

	.contract-body {
		margin-block-start: 0.6rem;
		max-width: 52rem;
		color: var(--fp-text-secondary);
		font-size: 0.9375rem;
	}

	.roadmap {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.75rem;
		color: var(--fp-text-muted);
	}

	@media (min-width: 52rem) {
		.diagram {
			grid-template-columns: minmax(0, 1fr) 8.5rem minmax(0, 1fr);
		}

		.wire {
			min-height: 0;
			background: linear-gradient(var(--fp-border-strong), var(--fp-border-strong)) center / 100% 1px no-repeat;
		}

		.contract {
			grid-column: 1 / -1;
		}

		/* Two dashed drops, one from each side, instead of the single centred one. */
		.contract::before {
			inset-inline: 22% 22%;
			border-inline: 1px dashed var(--fp-ai-text);
		}
	}
</style>
