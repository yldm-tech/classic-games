---
import Phrases from '../Phrases.astro';
import { type Locale, landing } from '../../i18n/landing.ts';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const local = landing[locale].local;
const planned = landing[locale].planned;
---

<section class="fp-section" id="local" aria-labelledby="local-title">
	<div class="fp-container">
		<div class="fp-section-head">
			<p class="fp-eyebrow">{local.eyebrow}</p>
			<h2 class="fp-h2" id="local-title"><Phrases text={local.title} /></h2>
			<p class="fp-lead">{local.lead}</p>
		</div>
		<ul class="facts">
			{
				local.facts.map((fact) => (
					<li class="fact">
						<h3 class="fp-h3">{fact.title}</h3>
						<p>{fact.body}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<section class="fp-section" id="planned" aria-labelledby="planned-title">
	<div class="fp-container">
		<div class="fp-section-head">
			<p class="fp-eyebrow">{planned.eyebrow}</p>
			<h2 class="fp-h2" id="planned-title"><Phrases text={planned.title} /></h2>
			<p class="fp-lead">{planned.lead}</p>
		</div>
		<ul class="genres">
			{planned.genres.map((genre) => <li>{genre}</li>)}
		</ul>
		<p class="note">{planned.note}</p>
	</div>
</section>

<style>
	.facts {
		display: grid;
		gap: 1.5rem;
	}

	/* The launcher marks the focused row with a 4px bar on its left edge; the same bar marks each fact. */
	.fact {
		padding-inline-start: 1.25rem;
		border-inline-start: 4px solid var(--fp-text);
	}

	.fact p {
		margin-block-start: 0.5rem;
		color: var(--fp-text-secondary);
	}

	.genres {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
		gap: 0.75rem;
	}

	.genres li {
		display: flex;
		align-items: center;
		min-height: 3.75rem;
		padding: 0.75rem 1.25rem;
		border: 1px solid var(--fp-border);
		border-radius: var(--fp-radius);
		color: var(--fp-text-secondary);
		font-size: 1.0625rem;
		letter-spacing: 0.04em;
	}

	.note {
		margin-block-start: 1.5rem;
		max-width: 46rem;
		color: var(--fp-text-muted);
	}

	@media (min-width: 48rem) {
		.facts {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 2rem;
		}
	}
</style>
