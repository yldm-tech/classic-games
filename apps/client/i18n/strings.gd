class_name Strings
extends RefCounted

## 多语言字符串表(誊自原型 fp-i18n.js,zh 默认 · en · ja;见 docs/18-i18n.md)。
## 原型中的函数型文案在此为 "%s" 格式串,经 fmt() 填充;数字本地化用 I18n.format_number。
## 覆盖范围 = 已实现的 Shell 屏幕;新屏幕落地时同步三语补全,不留单语 key。

const LOCALES := ["zh", "en", "ja"]
const DEFAULT_LOCALE := "zh"

## 取文案。locale 没有该 key 时回落 zh;再没有则原样返回 key(开发期可见)。
static func t(locale: String, key: String) -> Variant:
	var table: Dictionary = TABLE.get(locale, TABLE[DEFAULT_LOCALE])
	if table.has(key):
		return table[key]
	if table != TABLE[DEFAULT_LOCALE] and TABLE[DEFAULT_LOCALE].has(key):
		return TABLE[DEFAULT_LOCALE][key]
	push_warning("缺失文案 key: %s (%s)" % [key, locale])
	return key

## 格式化文案:fmt("zh", "forks_this_week", ["2100"]) → 「本周 2100人二创」。
static func fmt(locale: String, key: String, args: Array) -> String:
	return (t(locale, key) as String) % args

## 游戏标题/简介(原型 9 款游戏的本地化内容)。
static func game_title(locale: String, id: String) -> String:
	var games: Dictionary = t(locale, "games")
	return games.get(id, {}).get("title", id)

static func game_desc(locale: String, id: String) -> String:
	var games: Dictionary = t(locale, "games")
	return games.get(id, {}).get("desc", "")

