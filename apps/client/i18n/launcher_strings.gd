class_name LauncherStrings
extends RefCounted

## Strings of the console launcher (zh default, en provided). They are read like every other string, through Strings.t(locale, "launcher.nav.home") / Strings.fmt, which hands every "launcher." key to lookup() here.
## Every key starts with "launcher." followed by the screen or area it belongs to. Game names, genres, taglines and achievement texts are catalog data (launcher/launcher_catalog.gd), not strings.

const PREFIX := "launcher."
const DEFAULT_LOCALE := "zh"

## The string for a key: the locale's own, else zh, else the key itself (visible during development).
static func lookup(locale: String, key: String) -> String:
	var table: Dictionary = TABLE.get(locale, TABLE[DEFAULT_LOCALE])
	if table.has(key):
		return table[key]
	if TABLE[DEFAULT_LOCALE].has(key):
		return TABLE[DEFAULT_LOCALE][key]
	push_warning("missing launcher string: %s (%s)" % [key, locale])
	return key

