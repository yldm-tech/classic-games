[importer_defaults]

; High-resolution game art is drawn smaller than it is authored, which needs mipmaps to stay clean (games/shared/game_sprites.gd). Every newly imported texture gets them; a pixel-art stage draws with nearest filtering and ignores them.
texture={
"mipmaps/generate": true
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
