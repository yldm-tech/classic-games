## The chunks of a stage in order, set pieces included.
static func layout(index: int) -> Array:
	var out: Array = []
	var base: Array = LAYOUTS[index]
	for chunk_index in base.size():
		out.append(base[chunk_index])
		if INSERTS[index].has(chunk_index):
			out.append(INSERTS[index][chunk_index])
	return out

## Build one stage. Returns { world, spawns: [{ kind, x, y, tx, ty }], start: Vector2, problems: [text] }. A spawn's x / y is the middle of the bottom edge of its cell.
static func build(index: int) -> Dictionary:
	var chunks: Array = layout(index)
	var world := World.new()
	var total := 0
	for chunk: Array in chunks:
		total += str(chunk[1][0]).length()
	world.width = total
	world.tiles.resize(total * World.ROWS)
	world.tiles.fill(World.EMPTY)
	var spawns: Array = []
	var problems: Array = []
	var cursor := 0
	var first_ground := 14
	for chunk_index in chunks.size():
		var chunk: Array = chunks[chunk_index]
		var ground := int(chunk[0])
		var rows: Array = chunk[1]
		var width := str(rows[0]).length()
		if chunk_index == 0:
			first_ground = ground
		for row_index in rows.size():
			var row: String = rows[row_index]
			if row.length() != width:
				problems.append("chunk %d row %d is %d wide, not %d" % [chunk_index, row_index, row.length(), width])
				continue
			var ty := ground - (rows.size() - 1 - row_index)
			for column in width:
				var key := row[column]
				var tx := cursor + column
				if row_index == rows.size() - 1:
					if key == "#" or key == "I":
						world.tiles[ty * total + tx] = World.ICE if key == "I" else World.SOLID
						for below in range(ty + 1, World.ROWS):
							world.tiles[below * total + tx] = World.SOLID
					continue
				if ty < 0:
					problems.append("chunk %d reaches above the stage" % chunk_index)
					continue
				match key:
					".":
						pass
					"#":
						world.tiles[ty * total + tx] = World.SOLID
					"I":
						world.tiles[ty * total + tx] = World.ICE
					"=":
						world.tiles[ty * total + tx] = World.ONEWAY
					"x":
						world.tiles[ty * total + tx] = World.CRUMBLE
					"^":
						world.tiles[ty * total + tx] = World.SPIKE
					"h", "H":
						world.plats.append(_plat(tx, ty, "x", 80.0, 4.0, 0.0 if key == "h" else PI))
					"u", "U":
						world.plats.append(_plat(tx, ty, "y", 48.0, 3.6, 0.0 if key == "u" else PI))
					_:
						spawns.append({"kind": key, "x": float(tx * World.TILE + 8), "y": float((ty + 1) * World.TILE), "tx": tx, "ty": ty})
		cursor += width
	world.step_plats(0.0)
	return {"world": world, "spawns": spawns, "start": Vector2(40.0, float(first_ground * World.TILE)), "problems": problems}

static func _plat(tx: int, ty: int, axis: String, distance: float, period: float, phase: float) -> Dictionary:
	var x := float(tx * World.TILE)
	var y := float(ty * World.TILE)
	return {"x": x, "y": y, "w": 40.0, "x0": x, "y0": y, "range": distance, "period": period, "phase": phase, "axis": axis, "dx": 0.0, "dy": 0.0}
