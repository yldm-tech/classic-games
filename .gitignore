# Godot 4 (apps/client/)
.godot/
export.cfg
# 导出 preset 是五端可复现构建配置，必须入库；证书/密码仅由本机或 CI 注入。
*.translation

# Godot exports / build artifacts, and the website build output (apps/web/dist/)
build/
dist/
*.import.log

# Go (apps/server/, apps/cli/, apps/mcp/, packages/dsl/, packages/sdk/)
# Every `make build` / `make cli-build` / `make mcp-build` writes into the module's bin/. go.work is tracked on purpose.
bin/
# go.work.sum is not tracked. Workspace-mode queries such as `go list -m all` (gopls runs it) write it, and what it holds depends on which commands ran. Dependencies are pinned by each module's own go.sum, which `make tidy-check` and `make go-standalone` (GOWORK=off) verify.
go.work.sum
# Binaries left by a bare `go build ./cmd/...` in the module directory. The leading slash keeps the cmd/<name>/ source directories tracked.
/apps/server/server
/apps/cli/forgeplay
/apps/cli/forgeplay.exe
/apps/mcp/forgeplay-mcp
/apps/mcp/forgeplay-mcp.exe
*.test
*.out
vendor/
# Godot QR runtime is an intentionally vendored MIT dependency required by
# preload paths in the client and must be present in clean CI checkouts.
!apps/client/vendor/
apps/client/vendor/*
!apps/client/vendor/qrcode/
!apps/client/vendor/qrcode/**
*.log
.env
.env.*
!.env.example

# Website (apps/web/) and Node tooling. pnpm-lock.yaml is tracked.
node_modules/
.pnpm-store/
.astro/
# Markdown copied in from docs/ by apps/web/src/integrations/docs-sync.ts on every dev, build and check run. The source of truth is docs/.
/apps/web/src/content/docs/docs/
/apps/web/src/content/docs/legal/

# OS
.DS_Store
Thumbs.db

# Local isolated implementation worktrees
.worktrees/

# Internal strategy and planning notes kept out of the public tree
docs-internal/

# 运行时 SQLite 数据库(开发默认 apps/server/forgeplay.db)
forgeplay.db
*.db
